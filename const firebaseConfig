let wheelSpinning = false, wheelRotation = 0;
function renderWheel() {
  const items = state.wheelItems?.length ? state.wheelItems : defaultState.wheelItems, seg = 360 / items.length;
  const wrap = $('wheelWrap');
  wrap.style.background = 'conic-gradient(' + items.map((_, i) => `hsl(${(i * 70 + 210) % 360} 70% 50%) ${i * seg}deg ${(i + 1) * seg}deg`).join(',') + ')';
