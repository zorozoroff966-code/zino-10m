  };
  return pc;
}
async function closeP2p() {
  stopVoiceRecording(true);
  p2pSignalUnsubscribe?.(); p2pSignalUnsubscribe = null;
  const signalRef = p2pSignalRef;
  const removeSignal = p2pRole === 'host' && signalRef && db && auth?.currentUser;
  p2pSignalRef = null; p2pAnswerApplied = false;
