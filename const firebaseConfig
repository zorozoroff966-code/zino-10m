  if (wheelSpinning) return;
  const raw = $('wheelInput').value.trim();
  if (raw) { const its = raw.split(/[,،]/).map(s => s.trim()).filter(Boolean); if (its.length < 2) { $('wheelResult').textContent = 'أدخل خيارين على الأقل'; return; } state.wheelItems = its; saveState(); renderWheel(); }
  const items = state.wheelItems, seg = 360 / items.length;
  wheelSpinning = true;
  const idx = Math.floor(Math.random() * items.length);
  const target = 360 - (idx * seg + seg / 2);
  const cur = wheelRotation % 360;
  wheelRotation += 360 * 5 + ((target - cur) % 360 + 360) % 360;
  $('wheelWrap').style.transform = `rotate(${wheelRotation}deg)`;
  $('wheelResult').textContent = '...';
