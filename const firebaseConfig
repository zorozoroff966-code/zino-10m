  state.offlineMessages = keep(state.offlineMessages); state.reminders = keep(state.reminders); state.p2pMessages = keep(state.p2pMessages);
  const after = [state.offlineMessages, state.reminders, state.p2pMessages].map(a => a.length);
  if (before.join() !== after.join()) { saveState(); renderOfflineChat(); renderReminders(); renderP2p(); }
}

