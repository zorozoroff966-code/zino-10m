  $('pomodoroClock').textContent = `${String(Math.floor(pomoLeft / 60)).padStart(2,'0')}:${String(pomoLeft % 60).padStart(2,'0')}`;
  $('pomodoroMode').textContent = pomoMode === 'work' ? 'دورة عمل' : 'استراحة';
}
function pausePomodoro() { clearInterval(pomoInt); pomoInt = null; }
function startPomodoro() {
  if (pomoInt) return;
  pomoInt = setInterval(() => {
    if (pomoLeft > 0) { pomoLeft--; updatePomodoroUI(); return; }
    pausePomodoro();
    notifyUser(pomoMode === 'work' ? 'انتهت دورة العمل' : 'انتهت الاستراحة', pomoMode === 'work' ? 'خذ استراحة قصيرة.' : 'ابدأ دورة جديدة.');
    pomoMode = pomoMode === 'work' ? 'break' : 'work'; pomoLeft = pomoCfg[pomoMode]; updatePomodoroUI();
  }, 1000);
}
function resetPomodoro() { pausePomodoro(); pomoMode = 'work'; pomoLeft = pomoCfg.work; updatePomodoroUI(); }

/* ========= التنبيهات والمشاركة والتصدير ========= */
function notifyUser(title, body) {
  if (!('Notification' in window) || Notification.permission !== 'granted') return;
  const n = new Notification(title, { body }); setTimeout(() => n.close(), 5000);
}
function checkUpcomingEvents() {
  if (!('Notification' in window) || Notification.permission !== 'granted') return;
