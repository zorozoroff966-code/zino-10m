<link rel="manifest" href="./manifest.json" />
<title>zino_10M... | لوحة شخصية</title>
<style>
:root{--text:#18212f;--muted:#64748b;--primary:#6448ff;--primary-2:#2dd4bf;--danger:#ef4444;--warning:#f59e0b;--success:#22c55e;--panel:rgba(255,255,255,.92);--panel-soft:#eef1fb;--line:rgba(148,163,184,.3);--radius:22px;--shadow:0 18px 45px rgba(34,39,59,.12)}
body.dark{--text:#e5eefb;--muted:#9aa8bf;--primary:#8b5cf6;--primary-2:#34d399;--danger:#f87171;--warning:#fbbf24;--success:#4ade80;--panel:rgba(15,23,42,.6);--panel-soft:#111c2d;--line:rgba(255,255,255,.1);--shadow:0 18px 45px rgba(2,6,23,.45)}
*{box-sizing:border-box}
html,body{margin:0;font-family:"Tajawal","Segoe UI",Tahoma,sans-serif;color:var(--text);min-height:100%}
body{background:linear-gradient(135deg,#eef2ff,#f5f7fb) fixed;transition:background .25s,color .25s}
body.dark{background:radial-gradient(circle at top right,rgba(139,92,246,.38),transparent 18%),linear-gradient(135deg,#070d1f,#111827 30%,#1b1038) fixed}
button,input,select,textarea{font:inherit}
.hidden{display:none!important}
.auth-shell{min-height:100vh;display:grid;place-items:center;padding:24px}
.auth-card{width:min(100%,470px);background:var(--panel);border:1px solid var(--line);backdrop-filter:blur(18px);box-shadow:var(--shadow);border-radius:30px;padding:28px 22px}
.brand{text-align:center;margin-bottom:18px}
.brand-badge{width:68px;height:68px;margin:0 auto 12px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--primary-2));color:#fff;font-size:1.8rem;font-weight:700}
.brand h1{margin:0;font-size:2rem}.brand p{margin:8px 0 0;color:var(--muted)}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;background:var(--panel-soft);padding:6px;border-radius:16px;margin:20px 0 14px}
.tab-btn{border:none;background:transparent;color:var(--muted);padding:10px;border-radius:12px;cursor:pointer;font-weight:700}
.tab-btn.active{background:var(--panel);color:var(--text);box-shadow:0 6px 18px rgba(15,23,42,.08)}
form{display:flex;flex-direction:column;gap:12px}
label{display:flex;flex-direction:column;gap:8px;font-size:.9rem;color:var(--muted);font-weight:600}
input,select,textarea{border:1px solid var(--line);border-radius:14px;padding:12px 14px;background:var(--panel-soft);color:var(--text);outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(100,72,255,.1)}
.primary-btn,.secondary-btn,.danger-btn,.small-btn{border:none;border-radius:14px;cursor:pointer;padding:12px 16px;font-weight:700;transition:transform .18s,filter .2s}
.primary-btn:hover,.secondary-btn:hover,.danger-btn:hover,.nav-btn:hover{transform:translateY(-2px);filter:brightness(1.05)}
.primary-btn{background:linear-gradient(135deg,var(--primary),#7c3aed);color:#fff}
.secondary-btn,.small-btn{background:var(--panel-soft);color:var(--text);border:1px solid var(--line)}
.small-btn{padding:10px 12px;border-radius:12px}
.danger-btn{background:rgba(239,68,68,.12);color:var(--danger)}
.guest-btn{width:100%;margin-top:10px}
.auth-lang-select,.lang-select{width:100%;font-weight:700}
.app-shell{max-width:1260px;margin:0 auto;padding:22px 18px 40px;min-height:100vh}
.topbar{background:linear-gradient(135deg,rgba(100,72,255,.9),rgba(45,212,191,.75));border-radius:24px;padding:18px 20px;display:flex;align-items:center;justify-content:space-between;color:#fff;box-shadow:0 20px 40px rgba(86,62,180,.25);flex-wrap:wrap;gap:12px}
.topbar h2{margin:0}
.topbar-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.topbar .secondary-btn,.topbar .lang-select{background:rgba(255,255,255,.16);color:#fff;border-color:rgba(255,255,255,.3);width:auto}
.topbar .lang-select option{color:#18212f}
.user-pill{background:rgba(255,255,255,.14);padding:8px 12px;border-radius:999px;font-weight:700}
.grid{display:grid;gap:18px;margin-top:22px}
.nav-grid{grid-template-columns:repeat(8,minmax(0,1fr))}
.nav-btn{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:18px;padding:12px 8px;font-weight:700;cursor:pointer}
.nav-btn.active{background:linear-gradient(135deg,rgba(100,72,255,.2),rgba(45,212,191,.15));border-color:var(--primary);color:var(--primary)}
.content-section{display:none}.content-section.active{display:block;animation:fadeIn .2s}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.stats-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
.card,.panel{background:var(--panel);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--line);backdrop-filter:blur(16px)}
.card{padding:18px}.panel{padding:20px}
.panel h3{margin:0 0 16px;font-size:1.2rem}
.stat-head{display:flex;justify-content:space-between;margin-bottom:12px;color:var(--muted);font-size:.9rem}
.stat-value{font-size:clamp(1.5rem,2vw,2.2rem);font-weight:800;margin:0}
.primary{color:var(--primary)}.green{color:var(--success)}.red{color:var(--danger)}
.two-col{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;margin-top:18px}
.section-gap{margin-top:18px}
.mini-form{display:grid;grid-template-columns:1.2fr .8fr auto;gap:10px;align-items:end}
.money-form{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end}
.item{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--panel-soft);border:1px solid var(--line);border-radius:16px;padding:12px 14px;margin-top:10px}
.item-main{display:flex;align-items:center;gap:12px;flex:1;min-width:0}
.item-main input[type=checkbox]{width:18px;height:18px;accent-color:var(--primary)}
.task-text{overflow-wrap:anywhere;font-weight:600}
.tag{display:inline-flex;min-width:60px;justify-content:center;padding:6px 8px;border-radius:999px;font-size:.8rem;font-weight:800;background:rgba(100,72,255,.14);color:var(--primary)}
.chip{background:var(--panel-soft);border:1px solid var(--line);padding:6px 10px;border-radius:999px;font-weight:700;font-size:.8rem}
.done .task-text{text-decoration:line-through;opacity:.7}
.action-group{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.list-wrap{margin-top:14px}
.empty-state{color:var(--muted);text-align:center;padding:18px 10px;border:1px dashed var(--line);border-radius:16px;margin-top:10px}
.action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.money-amount.income{color:var(--success)}.money-amount.expense{color:var(--danger)}
.note-box{width:100%;min-height:180px;resize:vertical}
.summary-box{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}
.small-card{background:var(--panel-soft);border-radius:14px;padding:12px;border:1px solid var(--line)}
.small-card .label{color:var(--muted);font-size:.8rem;margin-bottom:6px}
.small-card .value{font-size:1.3rem;font-weight:800}
.chart{width:100%;height:180px;display:flex;align-items:end;gap:10px;padding-top:16px}
.bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:end}
.bar{width:100%;max-width:36px;border-radius:12px 12px 0 0;background:linear-gradient(180deg,var(--primary),var(--primary-2));min-height:12px}
.chart-box{margin-top:18px;background:var(--panel-soft);border-radius:16px;padding:12px;height:240px;position:relative}
.pomodoro-card,.xp-box,.plan-box,.goal-box{background:var(--panel-soft);border-radius:16px;padding:16px;border:1px solid var(--line)}
.pomodoro-card{text-align:center}
.pomodoro-mode{font-weight:800;color:var(--primary);margin-bottom:8px}
.pomodoro-clock{font-size:clamp(2rem,4vw,3rem);font-weight:900;margin-bottom:12px}
.pomodoro-controls{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.xp-row{display:flex;align-items:center;gap:12px;margin-top:8px}
.xp-bar{flex:1;height:12px;background:var(--line);border-radius:999px;overflow:hidden}
.xp-fill{height:100%;background:linear-gradient(90deg,var(--primary),var(--primary-2))}
.habit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.habit-item{text-align:center;padding:10px;border-radius:12px;border:1px solid var(--line);color:var(--muted);font-size:.85rem}
.habit-item.done{background:rgba(34,197,94,.12);color:var(--success);font-weight:800}
.badge-list{display:flex;flex-wrap:wrap;gap:10px}
.badge-pill{display:inline-flex;gap:8px;background:rgba(100,72,255,.12);border:1px solid rgba(100,72,255,.22);border-radius:999px;padding:8px 12px;font-weight:700}
.badge-pill.unlocked{background:rgba(34,197,94,.12);border-color:rgba(34,197,94,.25);color:var(--success)}
.chat-status{display:inline-flex;background:rgba(34,197,94,.12);color:var(--success);padding:8px 12px;border-radius:999px;font-size:.82rem;font-weight:700;margin-bottom:12px}
.chat-status.offline{background:rgba(239,68,68,.12);color:var(--danger)}
.chat-messages{display:flex;flex-direction:column;gap:10px;max-height:240px;overflow-y:auto;border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:12px}
.chat-bubble{max-width:78%;border-radius:16px;padding:10px 12px;background:rgba(148,163,184,.15)}
.chat-bubble.mine{align-self:flex-end;background:linear-gradient(135deg,rgba(100,72,255,.2),rgba(45,212,191,.14))}
.chat-head{font-size:.72rem;color:var(--muted);font-weight:700;margin-bottom:4px}
.chat-time{margin-top:6px;font-size:.7rem;color:var(--muted)}
.chat-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;color:var(--muted);font-size:.8rem}
.p2p-composer{display:grid;grid-template-columns:auto auto minmax(0,1fr) auto;gap:8px;align-items:center}
.p2p-media-image{display:block;width:min(280px,100%);max-height:300px;object-fit:cover;border-radius:14px;border:1px solid var(--line);cursor:pointer}
.p2p-audio{width:min(300px,100%);max-width:100%}
.p2p-recording{display:flex;align-items:center;gap:10px;margin-top:8px;padding:9px 12px;border-radius:12px;background:rgba(239,68,68,.1);color:var(--danger);font-weight:800}
.p2p-recording-dot{width:9px;height:9px;border-radius:50%;background:var(--danger);animation:p2pRecordPulse 1s infinite}
@keyframes p2pRecordPulse{50%{opacity:.3;transform:scale(.75)}}
.p2p-transfer{font-size:.78rem;color:var(--muted);margin-top:8px}
@media(max-width:700px){.p2p-composer{grid-template-columns:1fr 1fr}.p2p-composer input[type=text]{grid-column:1/-1}.p2p-composer #p2pSendBtn{grid-column:1/-1}}
.story-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.story-item{text-align:center;min-width:80px}
.story-avatar{width:64px;height:64px;border-radius:20px;margin:0 auto 6px;background:linear-gradient(135deg,#ff7a18,#ff3d81,#7c3aed);display:grid;place-items:center;font-weight:800;color:#fff;border:3px solid rgba(255,255,255,.6)}
.story-name{font-size:.76rem;color:var(--muted);font-weight:700}
.reel-card{border-radius:24px;padding:22px;color:#fff;background:linear-gradient(135deg,#1d4ed8,#7c3aed 45%,#0f172a);min-height:200px;display:flex;flex-direction:column;justify-content:space-between;margin-top:12px}
.reel-card h4{margin:0 0 6px;font-size:1.2rem}.reel-card p{margin:0;opacity:.85}
.reel-actions{display:flex;gap:16px;margin-top:14px}
.action-bubble{cursor:pointer;font-weight:800;font-size:.85rem;transition:transform .18s}
.wheel-box{display:grid;place-items:center;gap:20px;margin-top:12px}
.wheel-holder{position:relative;width:min(76vw,320px);aspect-ratio:1}
.wheel-wrap{position:absolute;inset:0;border-radius:50%;border:8px solid rgba(100,72,255,.25);box-shadow:var(--shadow);overflow:hidden;transition:transform 4s cubic-bezier(.1,.7,.2,1)}
.wheel-label{position:absolute;top:50%;left:50%;width:50%;transform-origin:0 50%;text-align:right;padding-right:14px;font-size:.78rem;font-weight:800;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.5);white-space:nowrap;overflow:hidden}
.wheel-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,var(--danger),var(--primary));color:#fff;display:grid;place-items:center;font-weight:800;z-index:2}
.wheel-pointer{position:absolute;top:-12px;left:50%;transform:translateX(-50%);border-left:16px solid transparent;border-right:16px solid transparent;border-top:28px solid var(--warning);z-index:3}
.wheel-selected{font-weight:800;color:var(--primary);min-height:28px}
.plan-box ul{margin:0;padding-right:18px;display:grid;gap:10px}
.notes-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.notes-toolbar button{background:var(--panel-soft);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:8px 12px;cursor:pointer;font-weight:700}
.notes-preview{background:var(--panel-soft);border:1px solid var(--line);border-radius:16px;padding:16px;min-height:120px;margin-top:12px;line-height:1.7}
.notes-preview code{background:rgba(100,72,255,.12);border-radius:8px;padding:2px 6px}
@media(max-width:980px){.nav-grid{grid-template-columns:repeat(4,1fr)}.two-col,.stats-grid{grid-template-columns:1fr}.money-form{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.nav-grid{grid-template-columns:repeat(2,1fr)}.mini-form,.money-form{grid-template-columns:1fr}.item{flex-direction:column;align-items:flex-start}}
</style>
</head>
<body>
<div id="authScreen" class="auth-shell">
  <div class="auth-card">
    <div class="brand"><div class="brand-badge">Z</div><h1>zino_10M...</h1><p>لوحة تنظيم شخصية ذكية</p></div>
    <div class="tabs">
      <button class="tab-btn active" data-tab="login" data-i18n="loginTab">تسجيل الدخول</button>
      <button class="tab-btn" data-tab="register" data-i18n="registerTab">إنشاء حساب</button>
    </div>
    <select id="authLanguageSelect" class="auth-lang-select lang-sel" aria-label="Language">
      <option value="ar">العربية</option><option value="en">English</option><option value="fr">Français</option><option value="es">Español</option><option value="tr">Türkçe</option><option value="de">Deutsch</option>
    </select>
    <div id="loginFormWrap" style="margin-top:12px">
      <form id="loginForm">
        <label><span data-i18n="emailLabel">البريد الإلكتروني</span><input id="loginEmail" type="email" required /></label>
        <label><span data-i18n="passwordLabel">كلمة المرور</span><input id="loginPassword" type="password" required /></label>
        <button class="primary-btn" type="submit" data-i18n="loginBtn">تسجيل الدخول</button>
        <button id="googleSignInBtn" class="secondary-btn guest-btn" type="button" data-i18n="googleLogin">الدخول عبر Google</button>
        <button id="facebookSignInBtn" class="secondary-btn guest-btn" type="button" data-i18n="facebookLogin">الدخول عبر فيسبوك</button>
        <button id="guestBtn" class="secondary-btn guest-btn" type="button" data-i18n="guestLogin">الدخول كضيف</button>
      </form>
    </div>
    <div id="registerFormWrap" class="hidden" style="margin-top:12px">
      <form id="registerForm">
        <label><span data-i18n="fullNameLabel">الاسم الكامل</span><input id="registerName" type="text" required /></label>
        <label><span data-i18n="usernameLabel">اسم المستخدم</span><input id="registerUser" type="text" required /></label>
        <label><span data-i18n="emailLabel">البريد الإلكتروني</span><input id="registerEmail" type="email" required /></label>
        <label><span data-i18n="passwordLabel">كلمة المرور</span><input id="registerPassword" type="password" minlength="6" required /></label>
        <button class="primary-btn" type="submit" data-i18n="createAccountBtn">إنشاء الحساب</button>
      </form>
    </div>
  </div>
</div>

<div id="appScreen" class="app-shell hidden">
  <header class="topbar">
    <h2>zino_10M...</h2>
    <div class="topbar-meta">
      <select id="languageSelect" class="lang-select lang-sel" aria-label="Language">
        <option value="ar">العربية</option><option value="en">English</option><option value="fr">Français</option><option value="es">Español</option><option value="tr">Türkçe</option><option value="de">Deutsch</option>
      </select>
      <div id="userBadge" class="user-pill">مستخدم</div>
      <button id="notificationToggle" class="secondary-btn" type="button" data-i18n="notificationsBtn">🔔 التنبيهات</button>
      <button id="themeToggle" class="secondary-btn" type="button">🌙 الليل</button>
      <button id="logoutBtn" class="danger-btn" type="button" data-i18n="logoutBtn">تسجيل الخروج</button>
    </div>
  </header>

  <div class="grid nav-grid">
    <button class="nav-btn active" data-section="dashboard" data-i18n="navDashboard">لوحة التحكم</button>
    <button class="nav-btn" data-section="tasks" data-i18n="navTasks">المهام</button>
    <button class="nav-btn" data-section="calendar" data-i18n="navCalendar">المواعيد</button>
    <button class="nav-btn" data-section="money" data-i18n="navMoney">المصاريف</button>
    <button class="nav-btn" data-section="notes" data-i18n="navNotes">ملاحظات</button>
    <button class="nav-btn" data-section="planner" data-i18n="navPlanner">الخطة الذكية</button>
    <button class="nav-btn" data-section="wheel" data-i18n="navWheel">العجلة</button>
    <button class="nav-btn" data-section="chat" data-i18n="navChat">💬 التحدث مع الأصدقاء</button>
  </div>

  <section id="section-dashboard" class="content-section active">
    <div class="grid stats-grid">
      <div class="card"><div class="stat-head"><span>إجمالي المهام</span><span>✅</span></div><p id="totalTasks" class="stat-value primary">0</p></div>
      <div class="card"><div class="stat-head"><span>المكتملة</span><span>🎯</span></div><p id="doneTasks" class="stat-value green">0</p></div>
      <div class="card"><div class="stat-head"><span>الدخل</span><span>💰</span></div><p id="incomeTotal" class="stat-value green">0</p></div>
      <div class="card"><div class="stat-head"><span>المصروفات</span><span>💸</span></div><p id="expenseTotal" class="stat-value red">0</p></div>
    </div>

    <div class="two-col">
      <div class="panel"><h3>إضافة مهمة سريعة</h3>
        <div class="mini-form">
          <input id="rapidTaskInput" type="text" placeholder="اكتب مهمة اليوم" />
          <select id="rapidTaskType"><option value="عالية">عالية</option><option value="متوسطة" selected>متوسطة</option><option value="منخفضة">منخفضة</option></select>
          <button id="rapidTaskBtn" class="primary-btn">إضافة</button>
        </div>
      </div>
      <div class="panel"><h3>نسبة الإنجاز</h3>
        <div class="summary-box">
          <div class="small-card"><div class="label">التقدم</div><div id="completionRate" class="value">0%</div></div>
          <div class="small-card"><div class="label">المتبقي</div><div id="remainingTasks" class="value">0</div></div>
        </div>
      </div>
    </div>

    <div class="panel section-gap"><h3>مؤقت بومودورو</h3>
      <div class="pomodoro-card">
        <div id="pomodoroMode" class="pomodoro-mode">دورة عمل</div>
        <div id="pomodoroClock" class="pomodoro-clock">25:00</div>
        <div class="pomodoro-controls">
          <button id="pomodoroStartBtn" class="primary-btn">بدء</button>
          <button id="pomodoroPauseBtn" class="secondary-btn">إيقاف</button>
          <button id="pomodoroResetBtn" class="secondary-btn">إعادة</button>
        </div>
      </div>
    </div>

    <div class="panel section-gap"><h3>نظام التنافس والمكافآت</h3>
      <div class="xp-box">
        <div style="display:flex;justify-content:space-between"><strong id="xpLevelLabel">مستوى: مبتدئ</strong><span id="xpValueLabel">0 XP</span></div>
        <div class="xp-row"><div class="xp-bar"><div id="xpFill" class="xp-fill" style="width:0%"></div></div><span id="streakLabel">0 يوم</span></div>
      </div>
    </div>

    <div class="panel section-gap"><h3>الأوسمة والإنجازات</h3>
      <div id="badgeList" class="badge-list"></div>
      <button id="shareSummaryBtn" class="secondary-btn" type="button" style="margin-top:14px">مشاركة بطاقة اليوم</button>
