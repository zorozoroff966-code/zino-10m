async function waitP2pBuffer() {
  while (dc && dc.readyState === 'open' && dc.bufferedAmount > 4 * 1024 * 1024) await new Promise(r => setTimeout(r, 25));
  if (!dc || dc.readyState !== 'open') throw new Error('P2P_CLOSED');
}

// تصغير الصور الكبيرة قبل الإرسال (ما عدا GIF)
async function shrinkImage(file) {
  if (file.type === 'image/gif' || file.size < 400 * 1024) return file;
  try {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, 1280 / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas'); c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    const blob = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.8));
    return blob ? new File([blob], (file.name || 'image').replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file;
  } catch { return file; }
}

async function sendP2pFile(file, type) {
  if (!dc || dc.readyState !== 'open') return alert('غير متصل بصديق.');
  if (p2pSendingFile) return alert('انتظر حتى ينتهي إرسال الملف الحالي.');
  if (!file || file.size > P2P_MAX_FILE_SIZE) return alert('حجم الملف كبير جدًا. الحد الأقصى 15MB.');
  p2pSendingFile = true;
  const id = makeP2pId();
  try {
    const buffer = await file.arrayBuffer();
    const total = Math.max(1, Math.ceil(buffer.byteLength / P2P_CHUNK_SIZE));
    await waitP2pBuffer();
    dc.send(JSON.stringify({ t: 'file-start', id, type, name: file.name || type, mime: file.type || 'application/octet-stream', size: buffer.byteLength, total }));
    for (let i = 0; i < total; i++) {
      await waitP2pBuffer();
      dc.send(buffer.slice(i * P2P_CHUNK_SIZE, Math.min(buffer.byteLength, (i + 1) * P2P_CHUNK_SIZE)));
      showP2pTransfer(`جاري إرسال ${type === 'image' ? 'الصورة' : 'الرسالة الصوتية'}... ${Math.round(((i + 1) / total) * 100)}%`);
    }
    await waitP2pBuffer();
    dc.send(JSON.stringify({ t: 'file-end', id }));
    pushP2pMedia('me', type, URL.createObjectURL(file), file.size, file.name);
  } catch (error) {
    console.error('P2P file send:', error);
    alert('تعذر إرسال الملف. تأكد أن الاتصال ما زال مفتوحًا.');
  } finally { p2pSendingFile = false; hideP2pTransfer(); }
}

function finishIncomingFile() {
  const f = p2pIncomingFile; p2pIncomingFile = null;
  hideP2pTransfer();
  if (!f || f.received !== f.total || f.bytes !== f.size) return;
  try {
    const url = URL.createObjectURL(new Blob(f.chunks, { type: f.mime }));
    pushP2pMedia('peer', f.type, url, f.size, f.name);
  } catch (error) { console.error(error); }
}

function setupChannel(ch) {
  dc = ch; dc.binaryType = 'arraybuffer';
  dc.onopen = () => {
    setP2pStatus('متصل مباشرة', true);
    $('p2pPairBox').classList.add('hidden'); $('p2pChatBox').classList.remove('hidden');
    ch.send(JSON.stringify({ t: 'hello', name: state.profile?.username || 'صديق' }));
    renderP2p();
  };
  dc.onmessage = e => {
    try {
      if (typeof e.data === 'string') {
        const m = JSON.parse(e.data);
        if (m.t === 'hello') {
          p2pPeer = String(m.name || 'صديق').slice(0, 40);
          $('p2pPeerName').textContent = `المحادثة مع: ${p2pPeer}`;
          renderP2p();
        } else if (m.t === 'msg') {
          pushP2pText('peer', String(m.text || '').slice(0, 4000));
        } else if (m.t === 'file-start') {
          // نقبل صورًا وصوتًا فقط، وبأنواع محددة (حماية من ملفات خبيثة)
          const mime = String(m.mime || '').split(';')[0].toLowerCase();
          if (!P2P_MIME[m.type] || !P2P_MIME[m.type].test(mime)) return;
          const size = Number(m.size), total = Number(m.total);
          if (!size || size > P2P_MAX_FILE_SIZE || !total || total > Math.ceil(P2P_MAX_FILE_SIZE / P2P_CHUNK_SIZE) + 1) return;
          p2pIncomingFile = { type: m.type, mime, name: String(m.name || m.type).slice(0, 80), size, total, received: 0, bytes: 0, chunks: [] };
          showP2pTransfer(`جاري استلام ${m.type === 'image' ? 'الصورة' : 'الرسالة الصوتية'}...`);
        } else if (m.t === 'file-end') {
          finishIncomingFile();
        }
        return;
      }
      if (e.data instanceof ArrayBuffer && p2pIncomingFile) {
        const f = p2pIncomingFile;
        f.bytes += e.data.byteLength;
        if (f.bytes > f.size) { p2pIncomingFile = null; hideP2pTransfer(); return; }   // أكبر من المعلن: نرفضه
        f.chunks.push(e.data); f.received++;
        showP2pTransfer(`جاري استلام الملف... ${Math.round((f.received / f.total) * 100)}%`);
      }
    } catch (error) { console.error('P2P receive:', error); }
  };
  dc.onclose = () => { setP2pStatus('انقطع الاتصال', false); $('p2pChatBox').classList.add('hidden'); };
  dc.onerror = () => setP2pStatus('حدث خطأ في الاتصال', false);
}

async function newPc() {
  await closeP2p();
