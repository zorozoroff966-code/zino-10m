    await FB.setDoc(p2pSignalRef, { hostUid: user.uid, hostUsername: state.profile.username, offer: c.localDescription.toJSON(), answer: null, answerUid: null, status: 'waiting', createdAt: Date.now() });
    $('p2pOut').value = state.profile.username;
    $('p2pAccountShare').classList.remove('hidden'); $('p2pFriendEntry').classList.add('hidden');
    $('p2pHelp').textContent = 'أرسل اسم حسابك لصديقك وانتظر اتصاله.';
    $('p2pPairBox').classList.remove('hidden');
    p2pSignalUnsubscribe = FB.onSnapshot(p2pSignalRef, async snapshot => {
      const answer = snapshot.data()?.answer;
      if (!answer || !pc || p2pAnswerApplied) return;
      p2pAnswerApplied = true;
      try { await pc.setRemoteDescription(answer); }
      catch (error) { console.error('Apply WebRTC answer:', error); setP2pStatus('تعذر إكمال الاتصال', false); }
    });
  } catch (error) { console.error(error); alert('تعذر إنشاء الاتصال. تحقق من إعداد Firebase وقواعد Firestore.'); }
});
$('p2pJoinBtn').addEventListener('click', async () => {
  if (!window.RTCPeerConnection) return alert('المتصفح لا يدعم WebRTC.');
  if (!auth?.currentUser || !db) return alert('الاتصال باسم الحساب يحتاج تسجيل الدخول بحساب Firebase مُعدّ.');
  await closeP2p();
  $('p2pIn').value = '';
  $('p2pAccountShare').classList.add('hidden'); $('p2pFriendEntry').classList.remove('hidden');
  $('p2pHelp').textContent = 'اكتب اسم حساب صديقك للاتصال به.';
  $('p2pPairBox').classList.remove('hidden');
});
$('p2pApplyBtn').addEventListener('click', async () => {
  try {
    const username = $('p2pIn').value.trim();
    if (!username) return alert('اكتب اسم حساب صديقك.');
    const usernameSnap = await FB.getDoc(FB.doc(db, 'publicUsernames', publicUsernameId(username)));
    if (!usernameSnap.exists()) return alert('لم يتم العثور على هذا الحساب.');
    const hostUid = usernameSnap.data().uid;
    if (hostUid === auth.currentUser.uid) return alert('لا يمكنك الاتصال بحسابك نفسه.');
    const signalRef = FB.doc(db, 'calls', hostUid), signalSnap = await FB.getDoc(signalRef);
    if (!signalSnap.exists() || signalSnap.data().status !== 'waiting' || signalSnap.data().answer) return alert('هذا الحساب لا يستقبل اتصالات الآن. اطلب من صديقك بدء استقبال اتصال.');
    const c = await newPc();
    p2pRole = 'join'; p2pPeer = username;
    c.ondatachannel = event => setupChannel(event.channel);
    await c.setRemoteDescription(signalSnap.data().offer);
    await c.setLocalDescription(await c.createAnswer());
    await waitIce(c);
    await FB.updateDoc(signalRef, { answer: c.localDescription.toJSON(), answerUid: auth.currentUser.uid, status: 'connected' });
    $('p2pHelp').textContent = 'جاري الاتصال باسم الحساب...';
  } catch (error) { console.error(error); alert('تعذر الاتصال. تحقق من إعداد Firebase وقواعد Firestore، أو اطلب من صديقك بدء استقبال اتصال.'); }
});
$('p2pCopyBtn').addEventListener('click', async () => {
  const text = $('p2pOut').value; if (!text) return;
  try { await navigator.clipboard.writeText(text); alert('تم نسخ اسم الحساب.'); }
  catch { $('p2pOut').select(); document.execCommand('copy'); }
});
$('p2pSendBtn').addEventListener('click', () => {
  const text = $('p2pInput').value.trim(); if (!text) return;
  if (!dc || dc.readyState !== 'open') return alert('غير متصل بصديق.');
  dc.send(JSON.stringify({ t: 'msg', text }));
  pushP2pText('me', text);
  $('p2pInput').value = ''; $('p2pInput').focus();
});
$('p2pInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); $('p2pSendBtn').click(); } });

$('p2pImageBtn').addEventListener('click', () => {
  if (!dc || dc.readyState !== 'open') return alert('اتصل بصديق أولًا.');
  $('p2pImageInput').click();
});
$('p2pImageInput').addEventListener('change', async e => {
  const file = e.target.files?.[0]; e.target.value = '';
  if (!file) return;
  if (!file.type.startsWith('image/')) return alert('اختر صورة فقط.');
  await sendP2pFile(await shrinkImage(file), 'image');
});

/* ----- التسجيل الصوتي ----- */
async function startVoiceRecording() {
  if (mediaRecorder || mediaStream || recordStarting) return;          // منع تسجيلين معًا
  if (!dc || dc.readyState !== 'open') return alert('اتصل بصديق أولًا.');
  if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) return alert('المتصفح لا يدعم تسجيل الصوت، أو الصفحة ليست على HTTPS/localhost.');
  recordStarting = true;
  try {
    mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
    audioChunks = [];
    const mime = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/mp4'].find(x => MediaRecorder.isTypeSupported?.(x));
    mediaRecorder = mime ? new MediaRecorder(mediaStream, { mimeType: mime }) : new MediaRecorder(mediaStream);
    const rec = mediaRecorder;
    rec.ondataavailable = e => { if (e.data.size) audioChunks.push(e.data); };
    rec.onstop = async () => {
      clearTimeout(recordTimer);
      mediaStream?.getTracks().forEach(t => t.stop());
      mediaStream = null; mediaRecorder = null;
      $('p2pRecording').classList.add('hidden'); $('p2pVoiceBtn').textContent = '🎤 صوت';
      if (rec.discard) return;
      const blob = new Blob(audioChunks, { type: rec.mimeType || 'audio/webm' });
      if (!blob.size) return;
      const ext = blob.type.includes('ogg') ? 'ogg' : blob.type.includes('mp4') ? 'mp4' : 'webm';
      await sendP2pFile(new File([blob], `voice_${Date.now()}.${ext}`, { type: blob.type }), 'audio');
    };
    rec.start(250);
    recordTimer = setTimeout(() => stopVoiceRecording(), 60000);        // حد أقصى 60 ثانية
    $('p2pRecording').classList.remove('hidden'); $('p2pVoiceBtn').textContent = '⏺️ تسجيل';
  } catch (error) {
    console.error(error);
    mediaStream?.getTracks().forEach(t => t.stop());
    mediaStream = null; mediaRecorder = null;
    alert('لم يتم السماح باستخدام الميكروفون.');
  } finally { recordStarting = false; }
}
function stopVoiceRecording(discard = false) {
  clearTimeout(recordTimer);
  if (mediaRecorder && mediaRecorder.state !== 'inactive') { mediaRecorder.discard = discard; mediaRecorder.stop(); }
  else if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null; }
}
$('p2pVoiceBtn').addEventListener('click', () => { if (mediaRecorder?.state === 'recording') stopVoiceRecording(); else startVoiceRecording(); });
$('p2pStopRecordingBtn').addEventListener('click', () => stopVoiceRecording());

/* ========= الإقلاع ========= */
if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  window.addEventListener('load', () => navigator.serviceWorker.register('./service-worker.js').catch(() => {}));
}
setInterval(checkUpcomingEvents, 60000);
setInterval(purgeExpired, 60000);

switchTab('login'); applyLanguage(); applyTheme(); updatePomodoroUI();

// نسجّل مستمع Firebase دائمًا (حتى لو كنت ضيفًا سابقًا)، ونتجاهل الأحداث أثناء وضع الضيف
if (auth) {
  FB.onAuthStateChanged(auth, async user => {
    if (guestTransition || localStorage.getItem(GUEST_SESSION_KEY) === '1') return;
    if (user) { await loadUserData(user); showApp(); }
    else { state = clone(defaultState); currentStorageKey = STORAGE_KEY; applyLanguage(); applyTheme(); showAuth(); }
  });
}

const localSess = (() => { try { return JSON.parse(localStorage.getItem(LOCAL_SESSION_KEY) || 'null'); } catch { return null; } })();
if (localStorage.getItem(GUEST_SESSION_KEY) === '1') {
  await enterGuestMode();
} else if (!auth) {
  if (localSess?.userId) {
    const acc = Object.values(readAccounts()).find(a => a.userId === localSess.userId);
    if (acc) startLocalSession(acc); else showAuth();
  } else showAuth();
}
</script>
